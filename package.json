{
  "name": "lms-app",
  "homepage": "https://amala.garuda-indonesia.com/",
  "version": "1.0.1",
  "private": true,
  "dependencies": {
    "@types/dotenv": "^8.2.0",
    "antd": "^3.23.6",
    "axios": "^0.18.1",
    "dotenv": "^8.2.0",
    "env-cmd": "^10.1.0",
    "html-to-text": "^5.1.1",
    "iframe": "^1.0.0",
    "js-sha512": "^0.8.0",
    "jwt-simple": "^0.5.6",
    "md5": "^2.2.1",
    "moment": "^2.23.0",
    "moment-timezone": "^0.5.45",
    "react": "^16.10.2",
    "react-ckeditor-component": "^1.1.0",
    "react-copy-to-clipboard": "^5.0.1",
    "react-datepicker": "^2.9.6",
    "react-dom": "^16.10.2",
    "react-draggable": "^4.0.3",
    "react-excel-renderer": "^1.1.0",
    "react-html-parser": "^2.0.2",
    "react-idle-timer": "^4.2.12",
    "react-iframe": "^1.8.5",
    "react-json-view": "^1.19.1",
    "react-otp-input": "^3.1.1",
    "react-redux": "^6.0.0",
    "react-responsive-modal": "^4.0.1",
    "react-router-dom": "^4.2.2",
    "react-scripts": "1.1.4",
    "react-select": "^3.0.8",
    "react-stepzilla": "^6.0.2",
    "react-toastify": "^5.4.0",
    "reaptcha": "^1.7.2",
    "redux": "^4.0.4",
    "uuid": "^3.2.1"
  },
  "scripts": {
    "clean": "rm -rf build",
    "generate-build-version": "node generate-build-version",
    "compile-url": "node src/config/CompileURL.js",
    "prestart": "env-cmd -f .env.development npm run compile-url",
    "prestart:staging": "env-cmd -f .env.staging npm run compile-url",
    "prestart:production": "env-cmd -f .env.production npm run compile-url",
    "prebuild": "npm run generate-build-version && env-cmd -f .env.development npm run compile-url",
    "prebuild:staging": "npm run generate-build-version && env-cmd -f .env.staging npm run compile-url",
    "prebuild:production": "npm run generate-build-version && env-cmd -f .env.production npm run compile-url",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "build:staging": "env-cmd -f .env.staging npm run compile-url && env-cmd -f .env.staging react-scripts build && npm run obfuscate",
    "build:production": "env-cmd -f .env.production npm run compile-url && env-cmd -f .env.production react-scripts build && npm run obfuscate",
    "start:staging": "env-cmd -f .env.staging react-scripts start",
    "start:production": "env-cmd -f .env.production react-scripts start",
    "obfuscate": "node obfuscate-main.js",
    "serve": "serve -s build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.3",
    "serve": "^14.2.6",
    "webpack": "3.8.1"
  },
  "overrides": {
    "webpack": "3.8.1"
  }
}
